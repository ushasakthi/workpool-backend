NODE_ENV=development
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/workpool

# Atlas (UAT server): the real password goes only in the server's .env, never here
# MONGO_URI=mongodb+srv://workpool-app:<db_password>@atlascluster.zq2ulne.mongodb.net/workpool_uat?retryWrites=true&w=majority&appName=AtlasCluster


# JWT auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=15m
# Refresh tokens use a separate secret so an access-token leak can't be used to mint new ones
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRY=7d

# Comma-separated list of allowed CORS origins (e.g. the mobile app's dev server)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# 32-byte AES-256 key (64 hex chars) — encrypts User.nicNumber at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-generated-64-char-hex-key
# Local disk directory for uploaded NIC documents — never served as a static/public path
NIC_UPLOAD_DIR=./storage/nic-documents
# Local disk directory for uploaded profile photos — served only via the authenticated
# GET /users/:userId/photo route, never as a static/public path
PROFILE_PHOTO_DIR=./storage/profile-photos
# Local disk directory for uploaded vehicle photos — served only via the authenticated
# GET /vehicles/:id/photo route, never as a static/public path
VEHICLE_PHOTO_DIR=./storage/vehicle-photos

# TESTING ONLY: minutes before/after departure that the pickup PIN can be checked.
# Default 60. Set 1440 to allow any time on a ride day. Leave unset in production.
# PICKUP_WINDOW_MINUTES=60

# DEVELOPMENT ONLY: true = skip the pickup time window, so the PIN can be checked any day/time.
# Ignored unless NODE_ENV=development.
# SKIP_PICKUP_WINDOW=false

# Email (password reset, etc.) — defaults point at Mailpit for local dev:
#   brew install mailpit && brew services start mailpit
# SMTP on :1025, web inbox UI at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=WorkPool <no-reply@workpool.local>
# Scheme used to deep-link into the app from emails (matches app.config.ts `scheme`)
# APP_BASE_URL=workpoolfrontend://

# Optional overrides for `npm run seed:admin` — falls back to the defaults below if unset
# ADMIN_EMAIL=admin@workpool.local
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_NAME=WorkPool Admin
# ADMIN_PHONE=+94000000000
