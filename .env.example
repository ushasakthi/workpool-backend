NODE_ENV=development
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/workpool

# JWT auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=15m

# Comma-separated list of allowed CORS origins (e.g. the mobile app's dev server)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
