  "info": {
    "title": "WorkPool API",
    "description": "WorkPool cost-sharing carpooling platform API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nadeesha Perera"
          },
          "phone": {
            "type": "string",
            "example": "+94771234567"
          },
          "role": {
            "type": "string",
            "enum": [
              "passenger",
              "driver",
              "both"
            ]
          }
        }
      },
      "GeoPointDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "example": 6.9271
          },
          "lng": {
            "type": "number",
            "example": 79.8612
          },
          "label": {
            "type": "string",
            "example": "Colombo 03"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "UpdateTravelProfileDto": {
        "type": "object",
        "properties": {
          "homeLocation": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "workLocation": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "workStartTime": {
            "type": "string",
            "example": "08:30"
          },
          "workEndTime": {
            "type": "string",
            "example": "17:30"
          },
          "daysAvailable": {
            "type": "array",
            "example": [
              "Mon",
              "Tue",
              "Wed"
            ],
            "items": {
              "type": "string",
              "enum": [
                "Mon",
                "Tue",
                "Wed",
                "Thu",
                "Fri",
                "Sat",
                "Sun"
              ]
            }
          },
          "preferredRole": {
            "type": "string",
            "enum": [
              "driver",
              "passenger",
              "either"
            ]
          },
          "hideWorkplaceName": {
            "type": "boolean",
            "example": false,
            "description": "Hide the exact workplace name from other users' view of this profile"
          }
        }
      },
      "SubmitVerificationDto": {
        "type": "object",
        "properties": {
          "nicNumber": {
            "type": "string",
            "example": "199912345678"
          },
          "linkedinUrl": {
            "type": "string",
            "example": "https://www.linkedin.com/in/yourprofile"
          }
        },
        "required": [
          "nicNumber",
          "linkedinUrl"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nadeesha Perera"
          },
          "email": {
            "type": "string",
            "example": "nadeesha@example.com"
          },
          "password": {
            "type": "string",
            "example": "StrongPass1"
          },
          "phone": {
            "type": "string",
            "example": "+94771234567"
          },
          "role": {
            "type": "string",
            "enum": [
              "passenger",
              "driver",
              "both"
            ],
            "default": "passenger"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "phone"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "nadeesha@example.com"
          },
          "password": {
            "type": "string",
            "example": "StrongPass1"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "nadeesha@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Reset token received via the forgot-password flow"
          },
          "newPassword": {
            "type": "string",
            "example": "NewStrongPass1"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ReviewVerificationDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "rejected"
            ]
          },
          "rejectionReason": {
            "type": "string",
            "description": "Required when status is \"rejected\""
          }
        },
        "required": [
          "status"
        ]
      },
      "SuspendUserDto": {
        "type": "object",
        "properties": {
          "suspended": {
            "type": "boolean",
            "description": "true = suspend, false = lift the suspension"
          },
          "reason": {
            "type": "string",
            "example": "Repeated no-shows after warnings"
          }
        },
        "required": [
          "suspended"
        ]
      },
      "CreateVehicleDto": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "example": "Toyota"
          },
          "model": {
            "type": "string",
            "example": "Aqua"
          },
          "year": {
            "type": "number",
            "example": 2018,
            "minimum": 1980,
            "maximum": 2027
          },
          "plateNumber": {
            "type": "string",
            "example": "CAB-1234",
            "description": "Sri Lankan plate — current letter series (optionally with a province code, \"WP CAB-1234\") or the older numeric series (\"251-1234\")."
          },
          "seatsAvailable": {
            "type": "number",
            "example": 3,
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "make",
          "model",
          "year",
          "plateNumber",
          "seatsAvailable"
        ]
      },
      "UpdateVehicleDto": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "example": "Toyota"
          },
          "model": {
            "type": "string",
            "example": "Aqua"
          },
          "year": {
            "type": "number",
            "example": 2018,
            "minimum": 1980,
            "maximum": 2027
          },
          "plateNumber": {
            "type": "string",
            "example": "CAB-1234",
            "description": "Sri Lankan plate — current letter series (optionally with a province code, \"WP CAB-1234\") or the older numeric series (\"251-1234\")."
          },
          "seatsAvailable": {
            "type": "number",
            "example": 3,
            "minimum": 1,
            "maximum": 8
          },
          "isActive": {
            "type": "boolean",
            "description": "Set false to retire the vehicle without deleting it (hidden from ride posting)."
          }
        }
      },
      "CreateRideDto": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string",
            "example": "665f1b2c3d4e5f6a7b8c9d0e",
            "description": "Id of one of the caller's own vehicles"
          },
          "origin": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "destination": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "departureTime": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-15T07:30:00.000Z",
            "description": "Departure instant (ISO 8601) — must be in the future"
          },
          "daysOfWeek": {
            "type": "array",
            "example": [
              "Mon",
              "Wed",
              "Fri"
            ],
            "items": {
              "type": "string",
              "enum": [
                "Mon",
                "Tue",
                "Wed",
                "Thu",
                "Fri",
                "Sat",
                "Sun"
              ]
            }
          },
          "seatsAvailable": {
            "type": "number",
            "example": 3,
            "minimum": 1,
            "maximum": 8
          },
          "costContribution": {
            "type": "number",
            "example": 400,
            "minimum": 0,
            "description": "Suggested contribution toward shared fuel / running costs (LKR). A cost-sharing amount — never a fare, price, or commission."
          }
        },
        "required": [
          "vehicleId",
          "origin",
          "destination",
          "departureTime",
          "daysOfWeek",
          "seatsAvailable",
          "costContribution"
        ]
      },
      "UpdateRideDto": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string",
            "example": "665f1b2c3d4e5f6a7b8c9d0e",
            "description": "Id of one of the caller's own vehicles"
          },
          "origin": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "destination": {
            "$ref": "#/components/schemas/GeoPointDto"
          },
          "departureTime": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-15T07:30:00.000Z",
            "description": "Departure instant (ISO 8601) — must be in the future"
          },
          "daysOfWeek": {
            "type": "array",
            "example": [
              "Mon",
              "Wed",
              "Fri"
            ],
            "items": {
              "type": "string",
              "enum": [
                "Mon",
                "Tue",
                "Wed",
                "Thu",
                "Fri",
                "Sat",
                "Sun"
              ]
            }
          },
          "seatsAvailable": {
            "type": "number",
            "example": 3,
            "minimum": 1,
            "maximum": 8
          },
          "costContribution": {
            "type": "number",
            "example": 400,
            "minimum": 0,
            "description": "Suggested contribution toward shared fuel / running costs (LKR). A cost-sharing amount — never a fare, price, or commission."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "cancelled"
            ],
            "description": "Set to \"paused\" or \"cancelled\" to pause or cancel the ride"
          }
        }
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "rideId": {
            "type": "string",
            "example": "665f1b2c3d4e5f6a7b8c9d0e"
          },
          "seatsRequested": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "rideId",
          "seatsRequested"
        ]
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "example": "665f1b2c3d4e5f6a7b8c9d0e"
          },
          "rating": {
            "type": "number",
            "example": 5,
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "example": "On time and a smooth drive."
          }
        },
        "required": [
          "bookingId",
          "rating"
        ]
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "example": "665f1b2c3d4e5f6a7b8c9d0e"
          },
          "category": {
            "type": "string",
            "enum": [
              "no_show",
              "late_pickup",
              "unsafe_driving",
              "inappropriate_behaviour",
              "other"
            ],
            "example": "no_show"
          },
          "reason": {
            "type": "string",
            "example": "Waited 20 minutes at the pickup, no reply."
          }
        },
        "required": [
          "bookingId",
          "category"
        ]
      },
      "ResolveReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "reviewed",
              "dismissed"
            ],
            "description": "\"reviewed\" = upheld (still counts against Trust Score), \"dismissed\" = unfounded (stops counting)"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}